# Secrets
.env

# Environments & caches
.venv/
__pycache__/
*.pyc
.DS_Store

# Archived experiments and one-off scripts
backup/

# Data, results and model artifacts (regenerable via the pipeline)
*.jsonl
*.npz
*.npy
!internal_vector.npy
network_dids.json
_/
loc-classifier-*/
results*/
results*.json
*report.json
vector_errors.json
*.log
nohup.out

# Bunny edge worker
bunny_feed/node_modules/
bunny_feed/dist/

# Fine-tuned reranker checkpoints (tens of GB, retrain via train_jina_reranker.py)
loc-reranker-*/

# Per-experiment vector sidecars (the .npy they calibrate is ignored too).
# The two committed ones describe the vectors that ship, so keep them.
*_vector_*_meta.json
external_vector_meta.json
!internal_vector_meta.json
!internal_vector_bonsai_v2_meta.json

# Snapshots of previous runs kept for A/B comparison
*.prev.json
old_vector.json
old_metrics.txt
reposts_analysis.json

# Local backup copies of regenerable datasets
*.bak

# Language flags for the offline evaluation (regenerate: bunny_feed/dump_lang_flags.ts)
lang_flags_*.json
