# Secrets
.env

# Environments & caches
.venv/
.venv_de/
tmp_venv/
__pycache__/
*.pyc
.DS_Store
node_modules/

# Superseded work. Kept on disk, deliberately NOT tracked: archive/ is where
# anything that no longer serves the live feed goes, and tracking it would
# defeat the point of having it. Nothing in here is needed to reproduce
# production -- if it is, it does not belong in archive/.
archive/

# Corpora, embedding caches, trained vectors and sweep results. All regenerable
# by training/run_all.sh, and large. The deployed vectors are committed as JSON
# under bunny_feed/src/ instead, which is the only copy production reads.
training/data/
research/data/

# Bunny edge worker build output
bunny_feed/dist/

# Local snapshot of the previously deployed vector, for a fast manual rollback
*.prev.json
